# Environment
ENV=prod

# Elasticsearch Configuration
ES_HOST=elasticsearch:9200
ES_HEAP_SIZE=2g
ES_SECURITY_ENABLED=true
ES_MEMORY_LIMIT=2G
ELASTIC_PASSWORD=JobMarket2024Secure!

# Ports Configuration (vides en prod car gérés par nginx)
ES_PORT=
DASH_PORT=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Domain Configuration
DOMAIN_NAME=jobmarketv2.eastus.cloudapp.azure.com

# Data Directories Configuration
DATA_RAW_DIR=/app/data/raw/francetravail
DATA_TRANSFORMED_DIR=/app/data/transformed/francetravail
DATA_PROCESSED_DIR=/app/data/processed/francetravail
DATA_LOG_DIR=/app/data/logs/francetravail